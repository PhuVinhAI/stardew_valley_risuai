{
  "name": "risuai-multi-character-world",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-grade Bun + TypeScript workspace for authoring multi-character RisuAI worlds and compiling CharX v3.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "charx": "bun apps/cli/src/index.ts",
    "import:sample": "bun run charx import --project danganronpa-her --risuai ../Risuai",
    "build": "bun run charx build --project stardew-valley",
    "build:sample": "bun run charx build --project danganronpa-her",
    "build:exact": "bun run charx build --project danganronpa-her --exact",
    "check:world": "bun run charx check --project stardew-valley",
    "tokens": "bun run charx tokens --project stardew-valley",
    "check:sample": "bun run charx check --project danganronpa-her",
    "check:projects": "bun run charx check-all",
    "verify": "bun run charx verify --project danganronpa-her",
    "inspect": "bun run charx inspect projects/examples/danganronpa-her/reference/CharX File.charx",
    "viewer": "bun run --cwd apps/viewer dev",
    "viewer:data": "bun run charx catalog",
    "docs:samples": "bun run charx docs",
    "clean": "bun run charx clean",
    "viewer:check": "bun run --cwd apps/viewer check",
    "viewer:build": "bun run --cwd apps/viewer build",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run viewer:check && bun test && bun run check:projects && bun run tokens && bun run viewer:build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@charx/core": "workspace:*",
    "@charx/risum-codec": "workspace:*",
    "@types/bun": "1.3.14",
    "fflate": "0.8.3",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  },
  "engines": {
    "bun": ">=1.2.19"
  },
  "packageManager": "bun@1.3.14"
}
