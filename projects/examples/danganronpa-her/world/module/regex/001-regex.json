{
  "comment": "코토다마",
  "in": "\\{\\s증거-1:\\s*(.+?)\\s*\\|\\s증거-2:\\s*(.+?)\\s*\\|\\s*증거-3:\\s*(.+?)\\s*\\|\\s*증거-4:\\s*(.+?)\\s*\\|\\s*증거-5:\\s*(.+?)\\s*\\}",
  "out": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    @font-face {\n      font-family: 'NeoDunggeunmo';\n      src: url('https://fastly.jsdelivr.net/gh/projectnoonnu/noonfonts_2001@1.3/NeoDunggeunmo.woff') format('woff');\n      font-weight: normal;\n      font-style: normal;\n    }\n\n    .kotodama-nav label:nth-of-type(1),\n    .kotodama-nav label:nth-of-type(2),\n    .kotodama-nav label:nth-of-type(3),\n    .kotodama-nav label:nth-of-type(4),\n    .kotodama-nav label:nth-of-type(5) {\n      background-color: red;\n    }\n\n    input[type=\"radio\"]:checked + label {\n      background-color: #ff006e !important;\n    }\n.text-item {\n  transform: rotate(-5deg); /* 시계 반대방향으로 기울임 */\n}\n    .kotodama-text-stack {\n      position: relative;\n      width: 292px;\n      height: 175px;\n      background-image: url('{{raw::kotodama}}');\n  background-size: cover;\n  background-position: center;\n  background-repeat: no-repeat;\n      overflow: hidden;\n      margin: 0 auto;\n    }\n\n    .kotodama-text-stack .text-item {\n      position: absolute;\n      top: 90px;\n      left: 88px;\n    \n      width: 100%;\n      height: 100%;\n      font-size: 14px;\n      display: flex;\n      align-items: left;\n      justify-content: left;\n      color: black;\n\n  font-family: 'NeoDunggeunmo';\n      opacity: 0;\n      transition: opacity 0.3s ease;\n      z-index: 0;\n    }\n\n    input[type=\"radio\"] {\n      display: none;\n    }\n\n    #kotodama-bg1:checked ~ .kotodama-text-stack #kotodama-text1,\n    #kotodama-bg2:checked ~ .kotodama-text-stack #kotodama-text2,\n    #kotodama-bg3:checked ~ .kotodama-text-stack #kotodama-text3,\n    #kotodama-bg4:checked ~ .kotodama-text-stack #kotodama-text4,\n    #kotodama-bg5:checked ~ .kotodama-text-stack #kotodama-text5 {\n      opacity: 1;\n    }\n\n    .kotodama-nav {\n      position: absolute;\n      top: 34px;\n      left: 45px;\n      z-index: 1;\n    }\n\n    .kotodama-nav label {\n      display: inline-block;\n      width: 14px;\n  font-family: 'NeoDunggeunmo';\n      height: 14px;\n      background: #ccc;\n      margin: 2px;\n      border-radius: 50%;\n      cursor: pointer;\n      text-align: center;\n      line-height: 14px;\n      font-size: 7px;\n      font-weight: bold;\n      color: white;\n      box-shadow: 0 0 3px rgba(0, 0, 0, 0.5);\n    }\n\n    input[type=\"radio\"].kotodama-radio:checked + label {\n      background: #333 !important;\n    }\n  </style>\n</head>\n<body>\n  <!-- Hidden radio buttons -->\n  <input type=\"radio\" class=\"kotodama-radio\" name=\"kotodama-bg\" id=\"kotodama-bg1\" checked>\n  <input type=\"radio\" class=\"kotodama-radio\" name=\"kotodama-bg\" id=\"kotodama-bg2\">\n  <input type=\"radio\" class=\"kotodama-radio\" name=\"kotodama-bg\" id=\"kotodama-bg3\">\n  <input type=\"radio\" class=\"kotodama-radio\" name=\"kotodama-bg\" id=\"kotodama-bg4\">\n  <input type=\"radio\" class=\"kotodama-radio\" name=\"kotodama-bg\" id=\"kotodama-bg5\">\n\n  <div class=\"kotodama-text-stack\">\n    <div class=\"kotodama-nav\">\n      <label for=\"kotodama-bg1\">1</label>\n      <label for=\"kotodama-bg2\">2</label>\n      <label for=\"kotodama-bg3\">3</label>\n      <label for=\"kotodama-bg4\">4</label>\n      <label for=\"kotodama-bg5\">5</label>\n    </div>\n\n    <!-- Text Items Instead of Images -->\n    <div class=\"text-item\" id=\"kotodama-text1\">$1</div>\n    <div class=\"text-item\" id=\"kotodama-text2\">$2</div>\n    <div class=\"text-item\" id=\"kotodama-text3\">$3</div>\n    <div class=\"text-item\" id=\"kotodama-text4\">$4</div>\n    <div class=\"text-item\" id=\"kotodama-text5\">$5</div>\n  </div>\n</body>\n</html>\n\n",
  "type": "editdisplay",
  "ableFlag": false
