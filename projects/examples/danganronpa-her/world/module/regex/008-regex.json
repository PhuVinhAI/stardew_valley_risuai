den;\n      z-index: 1;\n    }\n    .slot03_scrollable-content {\n      font-family: 'NeoDunggeunmo';\n      font-size: 7px;\n      background: linear-gradient(to bottom, white, white);\n      -webkit-background-clip: text;\n      color: transparent;\nposition: absolute;\n      z-index: 2;\nwidth: 100%;\nmax-width: 80px;\nmax-height: 100px;\ntransform: rotate(10deg);\ntop: 0px;\nleft: 0;\n      right: 0;\n      pointer-events: none;\n    }\n\n  </style>\n</head>\n\n<body><center><div class=\"slot03_image-stack\"><img src=\"{{raw::background_TA}}\" alt=\"Background\" class=\"slot03_back\"><img src=\"{{raw::$2_TA}}\" alt=\"Character\" class=\"slot03_front\"><img src=\"{{raw::class_TA}}\" alt=\"ui\" class=\"slot03_text-box\"><div class=\"slot03_text-box\"><div class=\"slot03_name\"></div><div class=\"slot03_scrollable-content-wrapper\"><div class=\"slot03_text-stroke\" style=\"top: -57px; left: 3px;\">$3</div><div class=\"slot03_scrollable-content\" style=\"top: -57px; left: 3px;\">$3</div><div class=\"slot03_text-stroke\" style=\"top: -13px; left: 3px;\">$4</div><div class=\"slot03_scrollable-content\" style=\"top: -13px; left: 3px;\">$4</div><div class=\"slot03_text-stroke\" style=\"top: 30px; left: 3px;\">$5</div><div class=\"slot03_scrollable-content\" style=\"top: 30px; left: 3px;\">$5</div><div class=\"slot03_text-stroke\" style=\"top: -57px; left: 208px;\">$6</div><div class=\"slot03_scrollable-content\" style=\"top: -57px; left: 208px;\">$6</div><div class=\"slot03_text-stroke\" style=\"top: -13px; left: 208px;\">$7</div><div class=\"slot03_scrollable-content\" style=\"top: -13px; left: 208px;\">$7</div><div class=\"slot03_text-stroke\" style=\"top: 30px; left: 208px;\">$8</div><div class=\"slot03_scrollable-content\" style=\"background: linear-gradient(to bottom, orange, orange);  -webkit-background-clip: text; top: 30px; left: 208px;\">$8</div></div></div></div></center><br><br></body></html>\n\n\n",
