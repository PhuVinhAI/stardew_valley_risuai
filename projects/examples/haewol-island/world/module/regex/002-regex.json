{
  "comment": "⚙︎ 상태창",
  "in": "\\[(.*?)\\|(.*?)\\|(.*?)\\s*\\]",
  "out": "@@move_top \n<div class=\"page\">\n    <div class=\"page-container\">\n        <div class=\"status-item\">\n            <div class=\"text-default\">⏳️|\n                <span class=\"text-default\" style=\"font-size: 130%; font-weight: bold;\">$1</span>\n                <div id=\"current-time\" class=\"text-default\">$2</div>\n            </div>\n        </div>\n        <div class=\"status-item\">\n            <div class=\"text-default\">🧭|\n                <span id=\"current-location\" class=\"text-default\" style=\"font-size: 130%; font-weight: bold;\">$3</span>\n            </div>\n        </div>\n        <hr class=\"status-divider\">\n        <div class=\"status-item\">\n            <div class=\"text-default\" style=\"font-weight: bold;\">평판|\n                <span id=\"current-Reputation\" class=\"reputation-text\">\n                    ✿ {{getvar::Reputation}} ✿\n                </span>\n                <div class=\"aff-stat-button-container\">\n                    <details>\n                        <summary class=\"aff-stat-summary\">❤ ?</summary>\n                        <div class=\"aff-stat-popup\">\n                            <div class=\"aff-stat-container\">\n                                <span class=\"aff-name\">유소유:</span>\n                                <div class=\"gauge-wrapper\">\n                                    <progress class=\"gauge\" value=\"{{calc::{{getvar::Soyou_aff}}+100}}\" min=\"0\"\n                                        max=\"350\"></progress>\n                                    <span class=\"gauge-value\">{{getvar::Soyou_aff}}</span>\n                                </div>\n                            </div>\n                            <div class=\"aff-stat-container\">\n                                <span class=\"aff-name\">강미연:</span>\n                                <div class=\"gauge-wrapper\">\n                                    <progress class=\"gauge\" value=\"{{calc::{{getvar::Mi-yeon_aff}}+100}}\" min=\"0\"\n                                        max=\"350\"></progress>\n                                    <span class=\"gauge-value\">{{getvar::Mi-yeon_aff}}</span>\n                                </div>\n                            </div>\n                            <div class=\"aff-stat-container\">\n                                <span class=\"aff-name\">정가연:</span>\n                                <div class=\"gauge-wrapper\">\n                                    <progress class=\"gauge\" value=\"{{calc::{{getvar::Ga-yeon_aff}}+100}}\" min=\"0\"\n                                        max=\"350\"></progress>\n                                    <span class=\"gauge-value\">{{getvar::Ga-yeon_aff}}</span>\n                                </div>\n                            </div>\n                            <div class=\"aff-stat-container\">\n                                <span class=\"aff-name\">최난희:</span>\n                                <div class=\"gauge-wrapper\">\n                                    <progress class=\"gauge\" value=\"{{calc::{{getvar::Nan-hee_aff}}+100}}\" min=\"0\"\n                                        max=\"350\"></progress>\n                                    <span class=\"gauge-value\">{{getvar::Nan-hee_aff}}</span>\n                                </div>\n                            </div>\n                        </div>\n                    </details>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>",
  "type": "editdisplay",
  "ableFlag": false
}
